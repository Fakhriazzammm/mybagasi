# ============================================================
# FRONTEND - Supabase (exposed to browser via Vite VITE_ prefix)
# ============================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
# Preferred new key format
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# Backward-compatible fallback
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ============================================================
# FRONTEND - Backend API
# ============================================================
VITE_BACKEND_BASE_URL=http://localhost:8000/api

# ============================================================
# FRONTEND - Mayar Payment Gateway
# ============================================================
VITE_MAYAR_DEFAULT_EMAIL=customer@example.com
VITE_MAYAR_DEFAULT_MOBILE=08123456789

# ============================================================
# FRONTEND - App
# ============================================================
VITE_APP_BASE_URL=http://localhost:5173

# ============================================================
# FRONTEND - Sumopod AI
# ============================================================
VITE_SUMOPOD_API_KEY=your-sumopod-api-key-here

# ============================================================
# SERVER-SIDE ONLY - Supabase (never expose with VITE_ prefix)
# ============================================================
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here
SUPABASE_SECRET_KEY=sb_secret_your-secret-key-here
