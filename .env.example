# Supabase - frontend safe (exposed to browser via Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
# Preferred (new key format)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# Backward-compatible fallback
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Supabase - server-side only (never use with VITE_ prefix)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here
SUPABASE_SECRET_KEY=sb_secret_your-secret-key-here

# AI / Backend
VITE_SUMOPOD_API_KEY=your-sumopod-api-key-here
VITE_BACKEND_BASE_URL=http://localhost:8000
VITE_FALLBACK_BACKEND_BASE_URL=https://43.129.54.5.nip.io

# Mayar defaults (used when user belum isi data lengkap)
VITE_MAYAR_DEFAULT_EMAIL=cs@mybagasi.id
VITE_MAYAR_DEFAULT_MOBILE=081234567890

# Frontend base URL (for payment redirect)
VITE_APP_BASE_URL=http://localhost:8080
