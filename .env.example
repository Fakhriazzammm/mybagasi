# Supabase - frontend safe (exposed to browser via Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
# Preferred (new key format)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# Backward-compatible fallback
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Supabase - server-side only (never use with VITE_ prefix)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here
SUPABASE_SECRET_KEY=sb_secret_your-secret-key-here

# AI / Backend
VITE_SUMOPOD_API_KEY=your-sumopod-api-key-here
VITE_OPENAI_API_KEY=your-openai-or-sumopod-key-here
VITE_OPENAI_BASE_URL=https://ai.sumopod.com/v1
OPENAI_BASE_URL=https://ai.sumopod.com/v1
VITE_OPENAI_MODEL=gpt-4o-mini
VITE_BACKEND_BASE_URL=http://localhost:8000
# Optional: isi jika punya backend fallback di VPS
# VITE_FALLBACK_BACKEND_BASE_URL=https://api-fallback.example.com

# Dynamic pricing config (hindari hardcode bisnis di frontend)
VITE_JPY_TO_IDR=105
VITE_SERVICE_FEE_RATE=0.15
VITE_SHIPPING_IDR=250000
VITE_TAX_RATE=0.08

# Mayar defaults (used when user belum isi data lengkap)
VITE_MAYAR_DEFAULT_EMAIL=cs@mybagasi.id
VITE_MAYAR_DEFAULT_MOBILE=081234567890
MAYAR_API_BASE=https://api.mayar.id/hl/v1
MAYAR_API_KEY=your-mayar-api-key-here
MAYAR_DEFAULT_EMAIL=cs@mybagasi.id
MAYAR_DEFAULT_MOBILE=081234567890
APP_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,https://app.mybagasi.com

# Frontend base URL (for payment redirect)
VITE_APP_BASE_URL=http://localhost:8080
